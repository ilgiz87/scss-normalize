{
  "php.validate.executablePath": "C:/path/to/php.exe", // Укажите путь к вашему PHP исполняемому файлу
  "php.suggest.basic": false,
  "intelephense.files.associations": ["*.php", "*.inc", "*.module", "*.theme", "*.twig", "*.html"],
  "intelephense.environment.documentRoot": "/path/to/joomla/root", // Укажите корневую директорию Joomla
  "intelephense.environment.includePaths": [
    "/path/to/joomla/libraries",
    "/path/to/joomla/components"
  ],
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.associations": {
    "*.html": "html",
    "*.css": "css",
    "*.scss": "scss",
    "*.js": "javascript"
  },
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "scss": "css"
  },
  "liveSassCompile.settings.formats": [
    {
      "format": "expanded",
      "extensionName": ".css",
      "savePath": "/css"
    }
  ],
  "liveSassCompile.settings.generateMap": true,
  "liveSassCompile.settings.autoprefix": ["> 1%", "last 1 versions"],
  "eslint.validate": ["javascript", "javascriptreact", "html"],

  // HTML форматирование
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // CSS форматирование
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // SCSS форматирование
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // JavaScript форматирование
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // Prettier настройки
  "prettier.singleQuote": true,
  "prettier.semi": true,
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "prettier.htmlWhitespaceSensitivity": "css",
  "prettier.printWidth": 120,
  "prettier.bracketSameLine": false,
  "prettier.arrowParens": "avoid",
  "prettier.endOfLine": "lf",

  // SCSS Formatter настройки для одинарных кавычек
  "scss.format.quotes": "single",
  "scss.format.insertSpaces": true,
  "scss.format.tabSize": 2,
  "scss.format.convert": true,
  "scss.format.newlineBetweenSelectors": true,
  "scss.format.newlineBetweenRules": true,

  // HTML специфичные настройки
  "html.format.wrapAttributes": "auto",
  "html.format.wrapLineLength": 120,
  "html.format.indentInnerHtml": true,
  "html.format.maxPreserveNewLines": 2,
  "html.format.preserveNewLines": true,
  "html.format.unformatted": "code, pre, textarea, script, style",
  "html.format.contentUnformatted": "pre, textarea",
  "html.format.extraLiners": "head, body, /html",
  "html.format.unformattedContentDelimiter": "",
  "html.format.indentHandlebars": false,
  "html.format.templating": false,
  "html.format.enable": true,
  "html.format.singleAttributePerLine": false,

  // Общие настройки редактора
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.rulers": [120, 160],
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true
}
